---
import { BaseLayout, Container } from "@silitics/astro-theme";
import { DocsSearch } from "@silitics/astro-docs";
import SiteFooter from "./SiteFooter.astro";
import { brand, nav, headerActions } from "../site.ts";

/**
 * Layout of a prose page outside the docs, such as a policy or an overview:
 * a label, the page heading, and the content as an article.
 */
interface Props {
  /** Title of the document, used in the browser tab and search results. */
  title: string;
  description?: string;
  /** Label above the heading, such as the section of the site. */
  eyebrow: string;
  /** Page heading. Defaults to the title. */
  heading?: string;
}

const { title, description, eyebrow, heading = title } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <DocsSearch slot="header-pre-actions" variant="header" />
  <Container class="pt-12 pb-16 md:pt-20 md:pb-24">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="title-display mt-5">{heading}</h1>
      <article class="article-prose marketing-prose mt-8">
        <slot />
      </article>
    </div>
  </Container>

  <SiteFooter slot="footer" />
</BaseLayout>

<style is:global>
  /* The first paragraph introduces the page, like the lead of a landing page. */
  .marketing-prose > p:first-child {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.55;
    color: var(--theme-content-muted);
  }
</style>
