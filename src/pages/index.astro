---
import {
  BaseLayout,
  Section,
  Button,
  Link,
  FaIcon,
} from "@silitics/astro-theme";
import SiteFooter from "../layouts/SiteFooter.astro";
import RugixAdminShowcase from "../components/RugixAdminShowcase.astro";
import { faRocket, faArrowRight } from "@fortawesome/free-solid-svg-icons";
import {
  brand,
  nav,
  headerActions,
} from "../site.ts";

const partners = [
  {
    href: "https://umbrel.com/",
    src: "/img/third-party-logos/umbrel.svg",
    alt: "Umbrel, Inc.",
  },
  {
    href: "https://goaqa.com/",
    src: "/img/third-party-logos/aqa.png",
    alt: "Aqa Technologies, Inc.",
  },
  {
    href: "https://www.ebike-checker.de/en/",
    src: "/img/third-party-logos/echecker.svg",
    alt: "eChecker",
  },
  {
    href: "https://enmo.ai/",
    src: "/img/third-party-logos/enmo.webp",
    alt: "Enmo",
  },
];

const stories = [
  {
    img: "/img/umbrel-pro.jpg",
    alt: "Umbrel Pro device",
    name: "Umbrel",
    body: `<a href="https://umbrel.com/">Umbrel</a> is a personal home cloud platform that lets anyone self-host their files, media, and applications with tens of thousands of installations worldwide. Umbrel chose Rugix as the foundation for <a href="https://umbrel.com/umbrelos">umbrelOS</a>, powering devices like the <a href="https://umbrel.com/umbrel-pro">Umbrel Pro</a>, its premium home cloud server. Rugix was chosen for its robustness, built-in state management with clean factory resets, and highly efficient delta updates.`,
  },
  {
    img: "/img/echecker-testbench.jpg",
    alt: "eChecker test bench with e-bike",
    name: "eChecker",
    body: `<a href="https://www.ebike-checker.de/en/">eChecker</a> builds test benches for e-bikes, drive units, and e-scooters used by test institutes and manufacturers worldwide. Each test bench is controlled by an embedded Linux system, powered by and updated through Rugix. Rugix enabled eChecker to easily build custom system images and reliably deliver over-the-air software updates to test benches deployed across customer sites.`,
  },
  {
    img: "/img/enmo-battery-brain.webp",
    alt: "BatteryBrain device",
    name: "BatteryBrain",
    body: `"At Enmo, we use Rugix for our product, BatteryBrain, a device optimizing battery systems based on spot prices, battery health, production inputs, and electricity markets. Rugix has been essential in bringing BatteryBrain to a production-ready state as quickly and efficiently as possible. It has simplified the creation of a custom Raspberry Pi image and enabled seamless over-the-air (OTA) updates."`,
    quote: "David Lekve, CTO at enmo",
  },
];

const tools = [
  {
    href: "/docs/ctrl",
    title: "Rugix Ctrl",
    blurb: "Deploy updates and manage workloads and state.",
    body: "Provides atomic system updates with automatic rollback, delta delivery, and signature verification, plus management of application workloads and persistent state. Integrates with different fleet management solutions.",
  },
  {
    href: "/docs/bakery",
    title: "Rugix Bakery",
    blurb: "Build custom Linux images.",
    body: "Builds production-ready Linux images based on Debian, Alpine Linux, and Raspberry Pi OS in a consistent containerized environment, with configurable system variants, VM testing, SBOMs, and integrated Rugix Ctrl updates.",
  },
  {
    href: "/docs/admin",
    title: "Rugix Admin",
    blurb: "Operate devices through a browser.",
    body: "Runs on the device and provides a browser-based interface to view system status, install updates, manage application workloads, and check component compatibility. Ideal for development, demos, and field service.",
  },
];

const proofPoints = [
  "Atomic & Signed Updates",
  "Automatic Rollback",
  "Bandwidth-Efficient Delivery",
  "Compatibility Checks",
  "No Lock-In",
];
---

<BaseLayout
  title="Rugix: The Open-Source Toolkit for Embedded Linux"
  description="Rugix provides open-source tools for deploying robust updates, managing application workloads and persistent state, building custom Linux images, and operating devices locally."
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <Section
    background="hero"
    padding="hero"
    class="!py-16 md:!py-24"
  >
    <div slot="decoration" class="bg-grid-fade absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-7xl px-4 text-center sm:px-6 lg:px-8">
      <h1
        class="font-display mx-auto max-w-3xl text-balance text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
      >
        The Open-Source Toolkit for Embedded Linux
      </h1>
      <p
        class="text-content mx-auto mt-6 max-w-2xl text-lg leading-relaxed md:text-xl"
      >
        Rugix provides tools to deploy robust updates, manage application
        workloads and persistent state, and build custom Linux images for your
        devices.
      </p>
      <div
        class="text-content-muted mx-auto mt-4 flex w-full flex-wrap items-center justify-center gap-x-2 gap-y-2 text-sm md:text-base"
        aria-label="Rugix capabilities and benefits"
      >
        {
          proofPoints.map((point, index) => (
            <span class="inline-flex items-center gap-2">
              {index > 0 && (
                <span class="text-content-subtle hidden sm:inline" aria-hidden="true">
                  ·
                </span>
              )}
              <span>{point}</span>
            </span>
          ))
        }
      </div>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href="/docs/getting-started">
          <FaIcon icon={faRocket} />
          Get Started in 30 Minutes
        </Button>
        <Button variant="secondary" href="/docs/ctrl">
          Explore the Docs
        </Button>
      </div>
    </div>
  </Section>

  <section class="border-divider bg-surface-1 relative border-y py-8">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <div
        class="flex flex-col items-center gap-8 md:flex-row md:justify-center md:gap-16"
      >
        <p
          class="text-content-subtle text-sm font-medium tracking-wider uppercase"
        >
          Trusted by
        </p>
        <div
          class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6"
        >
          {
            partners.map((partner) => (
              <a
                href={partner.href}
                target="_blank"
                rel="noopener"
                class="trusted-logo opacity-70 transition-opacity hover:opacity-100"
                aria-label={partner.alt}
              >
                <img
                  src={partner.src}
                  alt={partner.alt}
                  class="max-h-6 max-w-36 object-contain"
                />
              </a>
            ))
          }
          <span
            class="text-content-subtle text-xs font-medium tracking-wider uppercase"
          >
            and many more
          </span>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    [data-theme="light"] .trusted-logo {
      opacity: 0.72;
    }

    [data-theme="light"] .trusted-logo img {
      filter: brightness(0) !important;
    }

    [data-theme="light"] .trusted-logo:hover {
      opacity: 1;
    }

    @media (prefers-color-scheme: light) {
      :root:not([data-theme="dark"]) .trusted-logo {
        opacity: 0.72;
      }

      :root:not([data-theme="dark"]) .trusted-logo img {
        filter: brightness(0) !important;
      }

      :root:not([data-theme="dark"]) .trusted-logo:hover {
        opacity: 1;
      }
    }
  </style>

  <Section background="none" padding="default" class="!pt-16 md:!pt-24">
    <div class="text-center">
      <h2 class="font-display text-3xl font-bold md:text-4xl">
        The Rugix Toolkit
      </h2>
      <p class="text-content-muted mt-4 text-lg">
        Tools for on-device lifecycle management, custom image builds, and
        local device operation.
      </p>
    </div>
    <div class="mx-auto mt-12 grid max-w-6xl gap-6 md:grid-cols-3">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            class="card group flex flex-col gap-3 p-6 no-underline"
          >
            <h3 class="font-display text-xl font-semibold">{tool.title}</h3>
            <p class="text-content text-sm font-semibold">{tool.blurb}</p>
            <p class="text-content-muted text-sm leading-relaxed">{tool.body}</p>
            <span class="text-primary mt-auto inline-flex items-center gap-2 pt-2 text-sm font-medium">
              Learn more <FaIcon icon={faArrowRight} class="text-xs" />
            </span>
          </a>
        ))
      }
    </div>
    <p class="text-content-muted mx-auto mt-10 max-w-xl text-center text-sm leading-relaxed">
      Rugix Ctrl works with Yocto, Buildroot, other Linux build systems, and the{" "}
      <Link href="/fleet-management/">fleet management solution</Link>{" "}of
      your choice.
    </p>
  </Section>

  <RugixAdminShowcase />

  <Section background="none" padding="default">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold md:text-4xl">
        What Our Users Say
      </h2>
    </div>
    <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
      <blockquote class="card flex flex-col justify-center gap-4 p-6 italic">
        <p class="text-content leading-relaxed">
          "When you ship OTA updates to tens of thousands of devices in
          people's homes, you need rock-solid reliability. Rugix delivers
          exactly that."
        </p>
        <footer class="text-content-muted text-sm not-italic">
          Luke Childs, CTO at <Link href="https://umbrel.com/" external>Umbrel</Link>
        </footer>
      </blockquote>
      <blockquote class="card flex flex-col justify-center gap-4 p-6 italic">
        <p class="text-content leading-relaxed">
          "If you're not using Rugix, you're making things harder than they
          need to be."
        </p>
        <footer class="text-content-muted text-sm not-italic">
          David Lekve, CTO at <Link href="https://enmo.ai" external>enmo</Link>
        </footer>
      </blockquote>
      <blockquote class="card flex flex-col justify-center gap-4 p-6 italic">
        <p class="text-content leading-relaxed">
          "Rugix is thoughtfully designed, fast to get started with, and
          flexible in all the right ways. It's the tool suite for embedded
          Linux I've always wanted."
        </p>
        <footer class="text-content-muted text-sm not-italic">
          Rameen Aryanpur, CEO at <Link href="https://goaqa.com/" external>Aqa</Link>
        </footer>
      </blockquote>
    </div>
  </Section>

  <Section background="section" padding="default">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-bold md:text-4xl">Success Stories</h2>
    </div>
    <div class="mx-auto mt-12 grid max-w-6xl gap-12 md:grid-cols-2 lg:grid-cols-3">
      {
        stories.map((s) => (
          <div>
            <img
              src={s.img}
              alt={s.alt}
              class="border-divider aspect-video w-full rounded-xl border object-cover"
              loading="lazy"
            />
            <h3 class="font-display mt-4 text-xl font-semibold">{s.name}</h3>
            <p class="text-content-muted mt-2 text-sm leading-relaxed" set:html={s.body} />
            {s.quote && <p class="text-content-subtle mt-2 text-xs">{s.quote}</p>}
          </div>
        ))
      }
    </div>
  </Section>

  <Section background="cta" padding="default">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold md:text-4xl">
        Start Using Rugix Today
      </h2>
      <p class="text-content-muted mt-4 text-lg">
        Try the full Rugix workflow in under 30 minutes: build, boot, and
        update.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/docs/getting-started">
          Get Started
          <FaIcon icon={faArrowRight} />
        </Button>
        <Button variant="secondary" href="/commercial-support">
          Commercial Support
        </Button>
      </div>
    </div>
  </Section>

  <SiteFooter slot="footer" />
</BaseLayout>
