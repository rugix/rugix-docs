---
import {
  BaseLayout,
  CodeBlock,
  Container,
  FaIcon,
  Section,
  SpecList,
} from "@silitics/astro-theme";
import { DocsSearch } from "@silitics/astro-docs";
import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import SiteFooter from "../layouts/SiteFooter.astro";
import BrowserFrame from "../components/BrowserFrame.astro";
import { brand, nav, headerActions } from "../site.ts";

import systemLight from "../assets/rugix-admin/cropped/system-light.png";
import systemDark from "../assets/rugix-admin/cropped/system-dark.png";
import appsLight from "../assets/rugix-admin/cropped/apps-light.png";
import appsDark from "../assets/rugix-admin/cropped/apps-dark.png";
import componentsLight from "../assets/rugix-admin/cropped/components-light.png";
import componentsDark from "../assets/rugix-admin/cropped/components-dark.png";

const workflow = `# Start a project from a template
./run-bakery init quickstart-guide

# Build an image and boot it in a VM
./run-bakery run customized-efi-arm64

# Build an update bundle
./run-bakery bake bundle customized-efi-arm64

# On the device, install the update
rugix-ctrl update install system.rugixb`;

const partners = [
  {
    href: "https://umbrel.com/",
    src: "/img/third-party-logos/umbrel.svg",
    alt: "Umbrel, Inc.",
  },
  {
    href: "https://goaqa.com/",
    src: "/img/third-party-logos/aqa.png",
    alt: "Aqa Technologies, Inc.",
  },
  {
    href: "https://www.ebike-checker.de/en/",
    src: "/img/third-party-logos/echecker.svg",
    alt: "eChecker",
  },
  {
    href: "https://enmo.ai/",
    src: "/img/third-party-logos/enmo.webp",
    alt: "enmo",
  },
];

const tools = [
  {
    href: "/docs/ctrl",
    title: "Rugix Ctrl",
    blurb: "Update and manage devices.",
    body: "Atomic system updates with automatic rollback, delta delivery, and signature verification, plus application workloads and persistent state.",
  },
  {
    href: "/docs/bakery",
    title: "Rugix Bakery",
    blurb: "Build custom Linux images.",
    body: "Production-ready images based on Debian, Alpine Linux, and Raspberry Pi OS, with system variants, VM testing, SBOMs, and Rugix Ctrl built in.",
  },
  {
    href: "/docs/admin",
    title: "Rugix Admin",
    blurb: "Operate devices through a browser.",
    body: "A web interface on the device to check status, install updates, and manage apps. For development, demos, and field service.",
  },
];

const updates = [
  {
    term: "Atomic and signed",
    description:
      "An update installs completely or not at all, and only after its signature checks out.",
  },
  {
    term: "Automatic rollback",
    description:
      "Devices validate a new version on boot and fall back to the previous one if it fails.",
  },
  {
    term: "Bandwidth-efficient",
    description:
      "Delta updates download only what changed, for slow or metered networks.",
  },
  {
    term: "State management",
    description:
      "Declare the data that persists. Everything else returns to a known-good baseline.",
  },
];

const apps = [
  {
    term: "Independent releases",
    description:
      "Install, update, roll back, and remove apps without a system update.",
  },
  {
    term: "Instant rollback",
    description:
      "Previous generations stay on disk, so a rollback needs no download.",
  },
  {
    term: "Shared store",
    description:
      "Generations share deduplicated, compressed chunks, so container images take little extra space.",
  },
];

const compatibility = [
  {
    term: "Hardware",
    description: "A system image can require the hardware revision it supports.",
  },
  {
    term: "Operating system",
    description: "An app can require the base system versions it was built for.",
  },
  {
    term: "Active applications",
    description:
      "A system update that would break an active app fails before it installs.",
  },
];

interface Quote {
  text: string;
  author: string;
  role: string;
  company: string;
  href: string;
}

const quotes: Quote[] = [
  {
    text: "When you ship OTA updates to tens of thousands of devices in people’s homes, you need rock‑solid reliability. Rugix delivers exactly that.",
    author: "Luke Childs",
    role: "CTO at",
    company: "Umbrel",
    href: "https://umbrel.com/",
  },
  {
    text: "If you’re not using Rugix, you’re making things harder than they need to be.",
    author: "David Lekve",
    role: "CTO at",
    company: "enmo",
    href: "https://enmo.ai/",
  },
  {
    text: "Rugix is thoughtfully designed, fast to get started with, and flexible in all the right ways. It’s the tool suite for embedded Linux I’ve always wanted.",
    author: "Rameen Aryanpur",
    role: "CEO at",
    company: "Aqa",
    href: "https://goaqa.com/",
  },
];
const [featured, ...others] = quotes as [Quote, ...Quote[]];

const stories: {
  img: string;
  alt: string;
  name: string;
  body: string;
  fit?: string;
}[] = [
  {
    img: "/img/umbrel-pro.jpg",
    alt: "Umbrel Pro home cloud server",
    name: "Umbrel",
    body: `<a href="https://umbrel.com/">Umbrel</a> is a personal home cloud platform with tens of thousands of installations worldwide. Umbrel chose Rugix as the foundation for <a href="https://umbrel.com/umbrelos">umbrelOS</a>, which powers devices like the <a href="https://umbrel.com/umbrel-pro">Umbrel Pro</a>, for its robustness, state management with clean factory resets, and efficient delta updates.`,
  },
  {
    img: "/img/echecker-testbench.jpg",
    alt: "eChecker test bench with an e-bike",
    name: "eChecker",
    body: `<a href="https://www.ebike-checker.de/en/">eChecker</a> builds test benches for e-bikes, drive units, and e-scooters used by test institutes and manufacturers worldwide. An embedded Linux system built and updated with Rugix controls each test bench, so eChecker delivers software updates reliably to benches at customer sites.`,
  },
  {
    img: "/img/enmo-battery-brain.webp",
    alt: "BatteryBrain device by enmo",
    name: "enmo",
    body: `<a href="https://enmo.ai/">enmo</a> builds BatteryBrain, a device that optimizes battery systems based on spot prices, battery health, production inputs, and electricity markets. “Rugix has been essential in bringing BatteryBrain to a production-ready state as quickly and efficiently as possible,” says David Lekve, CTO at enmo.`,
    fit: "object-contain bg-black p-6",
  },
];
---

<BaseLayout
  title="Rugix: The Open-Source Toolkit for Embedded Linux"
  description="Rugix provides open-source tools for deploying robust updates, managing application workloads and persistent state, building custom Linux images, and operating devices locally."
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <DocsSearch slot="header-pre-actions" variant="header" />

  <section>
    <Container
      class="grid items-center gap-12 pt-12 pb-16 md:pt-20 md:pb-24 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-6">
        <p class="eyebrow">Open source · Embedded Linux</p>
        <h1 class="title-display mt-5">
          The <span class="whitespace-nowrap">open-source</span> toolkit for
          embedded Linux
        </h1>
        <p class="lead mt-6">
          Use Rugix to deploy robust updates, manage application workloads and
          persistent state, and build custom Linux images for your devices.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/docs/getting-started" class="btn-primary btn-lg">
            Get started in 30 minutes
            <FaIcon icon={faArrowRight} class="text-sm" />
          </a>
          <a href="/docs/ctrl" class="btn-secondary btn-lg">Explore the docs</a>
        </div>
      </div>
      <div class="min-w-0 lg:col-span-6">
        <CodeBlock lang="sh" title="Build, boot, and update" code={workflow} />
      </div>
    </Container>
  </section>

  <section class="border-divider border-t">
    <Container
      class="flex flex-col items-center gap-x-12 gap-y-6 py-10 lg:flex-row lg:justify-center"
    >
      <p class="eyebrow">Trusted by</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
        {
          partners.map((partner) => (
            <li>
              <a
                href={partner.href}
                target="_blank"
                rel="noopener"
                class="block opacity-70 transition-opacity hover:opacity-100"
              >
                <img
                  src={partner.src}
                  alt={partner.alt}
                  class="logo-mono max-h-6 max-w-36 object-contain"
                />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow">and many more</p>
    </Container>
  </section>

  <Section background="surface">
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">The toolkit</p>
        <h2 class="title-section mt-4">
          Three tools, from the first image to the field
        </h2>
      </div>
      <p
        class="text-content-muted leading-relaxed text-balance lg:col-span-7 lg:self-end"
      >
        Use them together or one at a time. Rugix Ctrl works with Yocto,
        Buildroot, and other build systems, and with the{" "}
        <a href="/fleet-management" class="text-primary underline"
          >fleet management solution</a
        >{" "}
        of your choice.
      </p>
    </div>
    <ul class="mt-12 grid gap-x-12 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <li class="accent-rule py-8">
            <a href={tool.href} class="group block">
              <h3 class="title-block group-hover:text-primary transition-colors">
                {tool.title}
              </h3>
              <p class="mt-2 font-medium">{tool.blurb}</p>
              <p class="text-content-muted mt-2 leading-relaxed">{tool.body}</p>
              <span class="text-primary mt-4 inline-flex items-center gap-2 text-sm font-medium">
                Read the docs
                <FaIcon
                  icon={faArrowRight}
                  class="text-xs transition-transform group-hover:translate-x-1"
                />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section class="border-divider border-t">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">System updates</p>
        <h2 class="title-section mt-4">Updates that never strand a device</h2>
        <p class="text-content-muted mt-5 leading-relaxed">
          Rugix Ctrl installs system updates into an inactive A/B slot and
          switches over only when the new version proves itself on the device.
        </p>
      </div>
      <SpecList class="lg:col-span-7" items={updates} />
    </div>
    <div class="mt-12 md:mt-16">
      <BrowserFrame
        light={systemLight}
        dark={systemDark}
        alt="Rugix Admin System view showing a committed system with U-Boot, A/B boot and system slots, state management, and boot groups"
        url="https://device.local/#/system"
      />
    </div>
  </Section>

  <Section class="border-divider border-t">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Rugix Apps · Experimental</p>
        <h2 class="title-section mt-4">
          Ship apps independently of the base system
        </h2>
        <p class="text-content-muted mt-5 leading-relaxed">
          Rugix Apps manages application workloads on top of a shared base
          system, each with its own lifecycle and persistent data.
        </p>
      </div>
      <SpecList class="lg:col-span-7" items={apps} />
    </div>
    <div class="mt-12 md:mt-16">
      <BrowserFrame
        light={appsLight}
        dark={appsDark}
        alt="Rugix Admin Apps view showing installed applications and application generations"
        url="https://device.local/#/apps"
      />
    </div>
  </Section>

  <Section class="border-divider border-t">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Compatibility checks · Experimental</p>
        <h2 class="title-section mt-4">
          Reject incompatible updates before they install
        </h2>
        <p class="text-content-muted mt-5 leading-relaxed">
          Rugix Ctrl knows what each device provides and what each update
          requires, so obviously wrong updates fail early with a clear reason.
        </p>
      </div>
      <SpecList class="lg:col-span-7" items={compatibility} />
    </div>
    <div class="mt-12 md:mt-16">
      <BrowserFrame
        light={componentsLight}
        dark={componentsDark}
        alt="Rugix Admin Components view showing component capabilities and dependencies on hardware and edge-os"
        url="https://device.local/#/components"
      />
    </div>
  </Section>

  <Section background="surface">
    <p class="eyebrow">In their words</p>
    <h2 class="title-section mt-4">Trusted in the field</h2>
    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <figure class="lg:col-span-7">
        <blockquote class="title-section -indent-[0.42em]">
          “{featured.text}”
        </blockquote>
        <figcaption class="accent-rule mt-8 max-w-xs pt-5 text-sm">
          <span class="block font-semibold">{featured.author}</span>
          <span class="text-content-muted">
            {featured.role}{" "}
            <a href={featured.href} class="hover:text-primary underline">
              {featured.company}
            </a>
          </span>
        </figcaption>
      </figure>
      <div class="border-divider divide-divider divide-y border-t lg:col-span-5 lg:border-t-0 lg:border-l lg:pl-12">
        {
          others.map((quote) => (
            <figure class="py-8 first:pt-0 last:pb-0 max-lg:first:pt-8">
              <blockquote class="text-lg leading-relaxed">
                “{quote.text}”
              </blockquote>
              <figcaption class="accent-rule mt-5 max-w-xs pt-4 text-sm">
                <span class="block font-semibold">{quote.author}</span>
                <span class="text-content-muted">
                  {quote.role}{" "}
                  <a href={quote.href} class="hover:text-primary underline">
                    {quote.company}
                  </a>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </Section>

  <Section class="border-divider border-t">
    <p class="eyebrow">Customer stories</p>
    <h2 class="title-section mt-4">Built on Rugix</h2>
    <div class="mt-12 grid gap-12 lg:grid-cols-3">
      {
        stories.map((story) => (
          <article>
            <img
              src={story.img}
              alt={story.alt}
              class:list={[
                "screenshot aspect-video w-full",
                story.fit ?? "object-cover",
              ]}
              loading="lazy"
            />
            <h3 class="title-block mt-6">{story.name}</h3>
            <p
              class="story-body text-content-muted mt-2 leading-relaxed"
              set:html={story.body}
            />
          </article>
        ))
      }
    </div>
  </Section>

  <section class="stage">
    <Container
      class="grid gap-8 py-16 md:py-24 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16"
    >
      <div>
        <h2 class="title-section max-w-2xl">Start using Rugix today</h2>
        <p class="text-content-muted mt-4">
          Try the full Rugix workflow in under 30 minutes: build, boot, and
          update.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/docs/getting-started" class="btn-primary btn-lg">
          Get started
          <FaIcon icon={faArrowRight} class="text-sm" />
        </a>
        <a href="/commercial-support" class="btn-secondary btn-lg">
          Commercial support
        </a>
      </div>
    </Container>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .story-body :global(a) {
    color: var(--theme-primary);
    text-decoration: underline;
  }
</style>
