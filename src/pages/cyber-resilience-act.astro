---
import {
  BaseLayout,
  Container,
  FaIcon,
  Section,
  SpecList,
} from "@silitics/astro-theme";
import { DocsSearch } from "@silitics/astro-docs";
import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import SiteFooter from "../layouts/SiteFooter.astro";
import { brand, nav, headerActions } from "../site.ts";

const milestones = [
  { date: "September 2026", label: "Reporting obligations apply" },
  { date: "December 2027", label: "Full enforcement" },
];

const requirements = [
  {
    term: "Secure by design",
    description: "Products are designed, built, and shipped to be secure.",
  },
  {
    term: "Software Bill of Materials",
    description: "A clear and up-to-date SBOM lists the components of each product.",
  },
  {
    term: "Security updates",
    description: "Timely security updates reach devices throughout the product's lifecycle.",
  },
  {
    term: "Vulnerability handling",
    description: "Processes cover vulnerability handling and incident reporting.",
  },
];

const buildingBlocks = [
  {
    term: "Robust updates with Rugix Ctrl",
    description:
      "Atomic A/B updates with automatic rollback and cryptographic signature verification. The CRA requires that you can deliver security updates reliably throughout your product's lifecycle.",
  },
  {
    term: "SBOM generation with Rugix Bakery",
    description:
      "Tailored Linux distributions with SBOMs generated as part of the build. These machine-readable lists of included components are a core CRA requirement and crucial for vulnerability management.",
  },
];
---

<BaseLayout
  title="Cyber Resilience Act"
  description="How Rugix helps you meet EU Cyber Resilience Act requirements."
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <DocsSearch slot="header-pre-actions" variant="header" />

  <section>
    <Container
      class="grid gap-12 pt-12 pb-16 md:pt-20 md:pb-24 lg:grid-cols-12 lg:items-end lg:gap-16"
    >
      <div class="lg:col-span-7">
        <p class="eyebrow">Compliance</p>
        <h1 class="title-display mt-5">Cyber Resilience Act</h1>
        <p class="lead mt-6">
          The <em>Cyber Resilience Act</em> (CRA) introduces mandatory
          cybersecurity requirements for all products with digital elements
          sold in the European Union. If you manufacture, import, or
          distribute connected devices or embedded software in the EU, this
          applies to you.
        </p>
      </div>
      <ol class="grid gap-x-10 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
        {
          milestones.map((milestone) => (
            <li class="accent-rule py-5">
              <p class="font-display text-2xl font-semibold tracking-tight">
                {milestone.date}
              </p>
              <p class="text-content-muted mt-1">{milestone.label}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>

  <Section class="border-divider border-t">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Requirements</p>
        <h2 class="title-section mt-4">What the CRA requires</h2>
        <p class="text-content-muted mt-5 leading-relaxed">
          The CRA covers everything from IoT devices and networked appliances
          to firmware and embedded Linux distributions. You must not only
          build secure systems, you must also prove they are secure,
          traceable, and maintained.
        </p>
      </div>
      <SpecList class="lg:col-span-7" items={requirements} />
    </div>
  </Section>

  <Section background="surface">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">How Rugix helps</p>
        <h2 class="title-section mt-4">Two building blocks of a compliant device</h2>
        <p class="text-content-muted mt-5 leading-relaxed">
          Together with <a href="https://www.ey.com/" class="text-primary underline">EY</a>{" "}
          and <a href="https://www.cumulocity.com/" class="text-primary underline">Cumulocity</a>,
          we have published a whitepaper on a practical reference
          architecture for CRA compliance. It combines EY's legal expertise,
          Cumulocity's IoT fleet management, and our embedded engineering
          experience. Rugix serves as a core component, providing essential
          on-device functionality.
        </p>
        <a
          href="/blog/cra-whitepaper-with-ey"
          class="group text-primary mt-6 inline-flex items-center gap-2 text-sm font-medium"
        >
          Read about the whitepaper
          <FaIcon
            icon={faArrowRight}
            class="text-xs transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>
      <SpecList class="lg:col-span-7" items={buildingBlocks} />
    </div>
  </Section>

  <Section>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow">Fleet management</p>
        <h2 class="title-section mt-4">From device to fleet</h2>
      </div>
      <div class="text-content-muted space-y-5 leading-relaxed lg:col-span-7">
        <p>
          Having the right on-device tooling is a necessary foundation, but
          the CRA also requires you to actually deliver updates to devices in
          the field and handle vulnerability reporting across your fleet.
          That means you need fleet management infrastructure on top of
          Rugix.
        </p>
        <p>
          Rugix is <a href="/fleet-management" class="text-primary underline"
            >designed to work with any fleet management solution</a
          >. If you are looking for a complete stack,{" "}
          <a href="https://nexigon.cloud" class="text-primary underline">Nexigon</a>,
          our fleet management platform, is built from the ground up to work
          with Rugix. It provides OTA update orchestration, real-time
          monitoring, and full audit logging for compliance, giving you a
          seamless path from build to deployment.
        </p>
      </div>
    </div>
  </Section>

  <section class="stage">
    <Container
      class="grid gap-8 py-16 md:py-24 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-16"
    >
      <div>
        <h2 class="title-section max-w-2xl">Prepare your devices for the CRA</h2>
        <p class="text-content-muted mt-4">
          We help teams build CRA-ready products with Rugix.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/commercial-support" class="btn-primary btn-lg">
          Talk to us
          <FaIcon icon={faArrowRight} class="text-sm" />
        </a>
        <a href="/docs/getting-started" class="btn-secondary btn-lg">
          Get started
        </a>
      </div>
    </Container>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
