---
import { BaseLayout, Container } from "@silitics/astro-theme";
import { DocsSearch } from "@silitics/astro-docs";
import SiteFooter from "../layouts/SiteFooter.astro";
import { brand, nav, headerActions } from "../site.ts";
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for does not exist."
  brand={brand}
  nav={nav}
  actions={headerActions}
  noindex
>
  <DocsSearch slot="header-pre-actions" variant="header" />
  <section>
    <Container class="pt-16 pb-24 md:pt-24 md:pb-32">
      <p class="eyebrow">404</p>
      <h1 class="title-display mt-5">Page not found</h1>
      <p class="lead mt-6 max-w-xl">
        The page you were looking for moved or never existed. Try the docs or
        head back home.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/" class="btn-primary btn-lg">Back to home</a>
        <a href="/docs/getting-started" class="btn-secondary btn-lg">
          Browse the docs
        </a>
      </div>
    </Container>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
