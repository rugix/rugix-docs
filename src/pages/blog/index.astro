---
import { getCollection } from "astro:content";
import { marked } from "marked";
import {
  BaseLayout,
  Container,
  Badge,
  FaIcon,
} from "@silitics/astro-theme";
import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import { DocsSearch } from "@silitics/astro-docs";
import SiteFooter from "../../layouts/SiteFooter.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import { brand, nav, headerActions } from "../../site.ts";
import {
  dateFromId,
  isBlogPostVisible,
  slugFromEntry,
  tagHref,
  teaserFor,
} from "../../lib/blog.ts";

/*
 * Pre-render every post's teaser to HTML at build time so the blog
 * index can paste it via `set:html`. Using `marked` here (rather than
 * the full Astro markdown pipeline) keeps the teaser surface light —
 * the index is a card grid, not a content page, and we don't want code
 * fences / mermaid / etc. running through Shiki here anyway.
 */
const posts = await getCollection("blog");
const sorted = posts
  .filter(isBlogPostVisible)
  .map((p) => {
    const teaser = teaserFor(p);
    return {
      post: p,
      date: p.data.date ?? dateFromId(p.id),
      teaserHtml: teaser ? marked.parse(teaser, { async: false }) : null,
    };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout
  title="Blog"
  description="Updates, releases, and engineering posts from the Rugix project."
  brand={brand}
  nav={nav}
  actions={headerActions}
>
  <DocsSearch slot="header-pre-actions" variant="header" />
  <section>
    <Container class="pt-12 pb-8 md:pt-20 md:pb-12">
      <p class="eyebrow">Blog</p>
      <h1 class="title-display mt-5">News from the Rugix project</h1>
      <p class="lead mt-6 max-w-2xl">
        Releases, deep-dives, and the occasional opinion piece.
      </p>
    </Container>
  </section>

  <div class="mx-auto flex w-full max-w-7xl flex-col gap-10 px-4 pt-8 pb-16 md:pb-24 lg:flex-row lg:px-6">
    <aside class="lg:sticky lg:top-20 lg:max-h-[calc(100dvh-6rem)] lg:w-60 lg:shrink-0 lg:self-start lg:overflow-y-auto">
      <BlogSidebar currentSlug="" />
    </aside>
    <ul class="border-divider max-w-3xl flex-1 border-t">
      {
        sorted.map(({ post, date, teaserHtml }) => {
          const href = `/blog/${slugFromEntry(post)}`;
          const tags = post.data.tags ?? [];
          return (
            <li>
              {/*
               * Stretched-link card. The teaser markdown contains its
               * own `<a>` tags (links to other posts, e.g. "delta
               * updates"); wrapping the whole card in an `<a>` would
               * nest anchors, which the browser auto-closes mid-card
               * and visibly fragments the layout. Instead we render
               * the title as the only anchor and let `::after` on it
               * blanket the card so the entire surface is clickable.
               */}
              <article class="border-divider group relative border-b py-8">
                <div class="text-content-subtle font-mono text-sm">
                  <time datetime={date.toISOString()}>
                    {date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "long",
                      day: "numeric",
                    })}
                  </time>
                </div>
                <h2 class="title-block mt-2 text-xl">
                  <a
                    href={href}
                    class="text-content group-hover:text-primary stretched-link transition-colors no-underline"
                  >
                    {post.data.title}
                  </a>
                </h2>
                {teaserHtml && (
                  <div
                    class="blog-teaser text-content-muted mt-2 leading-relaxed"
                    set:html={teaserHtml}
                  />
                )}
                {tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {tags.map((tag: string) => (
                      <a href={tagHref(tag)} class="relative z-[2] no-underline">
                        <Badge class="font-mono">{tag}</Badge>
                      </a>
                    ))}
                  </div>
                )}
                <span class="text-primary mt-4 inline-flex items-center gap-2 text-sm font-medium">
                  Read post <FaIcon icon={faArrowRight} class="text-xs" />
                </span>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style is:global>
  /*
   * Stretched-link pattern. The title link gets a transparent
   * `::after` that blankets the card so the entire surface is
   * clickable. Inner teaser links bump to a higher z-index so they
   * stay clickable on top of the overlay; everything else (text,
   * badges, "Read post" row) is purely visual and lets clicks fall
   * through to the overlay.
   */
  .stretched-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .blog-teaser a,
  .blog-teaser a:hover {
    position: relative;
    z-index: 2;
  }

  /*
   * Teaser markdown lives inside a card — keep styling minimal so the
   * card itself is the only visible "box". No code-chip borders, no
   * blockquote borders, no fenced-block surfaces. Inline emphasis,
   * links, and code render with subtle weight only.
   */
  .blog-teaser {
    color: inherit;
    line-height: 1.6;
  }
  .blog-teaser p {
    margin: 0 0 0.5rem;
  }
  .blog-teaser p:last-child {
    margin-bottom: 0;
  }
  /* Long teasers stop after their first paragraph's third line. */
  .blog-teaser > :not(:first-child) {
    display: none;
  }
  .blog-teaser > :first-child {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    margin-bottom: 0;
  }
  .blog-teaser a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-teaser strong {
    color: var(--theme-content);
    font-weight: 600;
  }
  .blog-teaser em {
    font-style: italic;
  }
  .blog-teaser code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: transparent;
    border: 0;
    padding: 0;
  }
  /* Hide large block elements. Teasers keep paragraphs and short lists. */
  .blog-teaser pre,
  .blog-teaser blockquote,
  .blog-teaser table,
  .blog-teaser hr,
  .blog-teaser h1,
  .blog-teaser h2,
  .blog-teaser h3,
  .blog-teaser h4,
  .blog-teaser h5,
  .blog-teaser h6,
  .blog-teaser img {
    display: none;
  }
  .blog-teaser ul,
  .blog-teaser ol {
    margin: 0 0 0.5rem;
    padding-left: 1.25rem;
  }
  .blog-teaser ul {
    list-style: disc;
  }
  .blog-teaser ol {
    list-style: decimal;
  }
</style>
